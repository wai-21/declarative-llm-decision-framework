#!/usr/bin/env python3
"""
output_validator.py — LLM Output Validator

Functions:
1. Structure validation — output must conform to schema
2. Consistency validation — detect logical contradictions across nested values
3. Forbidden-word blocking — deny-list regex
4. Number provenance — numbers in LLM output must exist in the API raw-data allowlist

Usage:
  from output_validator import validate_decision
  ok, errors, warnings = validate_decision(llm_output_json, api_provenance)
  if not ok:
      # return only error_code + offending values to the LLM for correction
      pass
"""

import re
import json
from typing import List, Tuple, Optional, Dict, Set


# ═══════════════════════════════════════════════
# 1. Forbidden words (domain-specific)
# ═══════════════════════════════════════════════

FORBIDDEN_WORDS = [
    # replace with your domain's forbidden words
    # e.g. "strong buy", "all-in", "guaranteed to rise", "zero risk"
]


def check_forbidden(text: str) -> List[str]:
    """Check whether the text contains forbidden words."""
    triggered = []
    for word in FORBIDDEN_WORDS:
        if word in text:
            triggered.append(word)
    return triggered


# ═══════════════════════════════════════════════
# 2. Structure validation
# ═══════════════════════════════════════════════

def validate_structure(data: dict, schema: dict) -> Tuple[bool, List[str]]:
    """
    Pydantic-free structural validation.

    schema format:
    {
        "field_name": {"type": "str", "required": True, "enum": [...], "min": 0, "max": 1},
        ...
    }
    """
    errors = []

    for field, rules in schema.items():
        # required check
        if rules.get('required', False) and field not in data:
            errors.append(f"Missing required field: {field}")
            continue

        if field not in data:
            continue

        value = data[field]

        # type check
        expected_type = rules.get('type')
        if expected_type == 'str' and not isinstance(value, str):
            errors.append(f"{field} should be string, got {type(value).__name__}")
        elif expected_type == 'int' and not isinstance(value, int):
            errors.append(f"{field} should be int")
        elif expected_type == 'float' and not isinstance(value, (int, float)):
            errors.append(f"{field} should be number")
        elif expected_type == 'list' and not isinstance(value, list):
            errors.append(f"{field} should be list")

        # enum check
        if 'enum' in rules and value not in rules['enum']:
            errors.append(f"{field} value {value} not in allowed range: {rules['enum']}")

        # range check
        if 'min' in rules and isinstance(value, (int, float)) and value < rules['min']:
            errors.append(f"{field} value {value} < min {rules['min']}")
        if 'max' in rules and isinstance(value, (int, float)) and value > rules['max']:
            errors.append(f"{field} value {value} > max {rules['max']}")

    return len(errors) == 0, errors


# ═══════════════════════════════════════════════
# 3. Consistency validation (cross-field contradiction detection)
# ═══════════════════════════════════════════════

def validate_consistency(data: dict, rules: List[dict]) -> Tuple[bool, List[str]]:
    """
    Consistency validation.

    rules format:
    [
        {
            "condition": lambda d: d.get("regime") == "RED" and d.get("cap") > 0,
            "message": "cap must be 0 under RED regime"
        },
        ...
    ]
    """
    errors = []
    for rule in rules:
        try:
            if rule['condition'](data):
                errors.append(rule['message'])
        except Exception as e:
            errors.append(f"Consistency rule execution error: {e}")
    return len(errors) == 0, errors


# ═══════════════════════════════════════════════
# 4. Number provenance
# ═══════════════════════════════════════════════

class NumberProvenance:
    """Extract a number allowlist from API raw data and validate LLM output against it."""

    def __init__(self):
        self.allowed_numbers: Set[float] = set()

    def ingest(self, data: dict, source: str):
        """Extract numbers from API responses into the allowlist."""
        text = json.dumps(data, default=str)
        numbers = re.findall(r'-?\d+\.?\d*', text)
        for n in numbers:
            try:
                self.allowed_numbers.add(round(float(n), 4))
            except ValueError:
                pass

    def verify(self, llm_output: str, tolerance: float = 0.1) -> List[Tuple[str, float]]:
        """Check whether numbers in LLM output are within the allowlist."""
        violations = []
        numbers = re.findall(r'-?\d+\.?\d*', llm_output)

        for n in numbers:
            try:
                val = round(float(n), 4)
            except ValueError:
                continue

            # skip years, booleans, small integers
            if 2020 <= val <= 2030:
                continue
            if val in (0, 1):
                continue

            found = any(abs(val - a) < tolerance for a in self.allowed_numbers)
            if not found:
                violations.append((n, val))

        return violations


# ═══════════════════════════════════════════════
# 5. One-call validation entry
# ═══════════════════════════════════════════════

def validate_decision(
    llm_output: dict,
    schema: dict,
    consistency_rules: List[dict],
    provenance: Optional[NumberProvenance] = None,
    llm_text: str = ""
) -> Tuple[bool, List[str], List[str]]:
    """
    One-call validation of LLM decision output.

    Returns:
        (ok, errors, warnings)
    """
    errors = []
    warnings = []

    # 1. structure
    ok_struct, errs = validate_structure(llm_output, schema)
    errors.extend(errs)

    # 2. consistency
    ok_cons, errs = validate_consistency(llm_output, consistency_rules)
    errors.extend(errs)

    # 3. forbidden words
    forbidden = check_forbidden(llm_text or json.dumps(llm_output))
    if forbidden:
        errors.append(f"Forbidden word triggered: {forbidden}")

    # 4. number provenance
    if provenance:
        violations = provenance.verify(llm_text or json.dumps(llm_output))
        if violations:
            warnings.append(f"Suspect number provenance: {violations[:10]}")

    ok = len(errors) == 0
    return ok, errors, warnings
