{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://your-domain/decision-state/v1",
  "title": "DecisionState — Declarative Decision State",
  "description": "State snapshot emitted after script pre-computation; the LLM receives only this structure for logical decisions.",
  "type": "object",
  "required": ["timestamp", "regime", "items"],
  "properties": {
    "timestamp": {"type": "string", "format": "date-time"},
    "regime": {
      "type": "object",
      "required": ["name", "level"],
      "properties": {
        "name": {"type": "string", "description": "Current environment / stage"},
        "level": {"type": "integer", "minimum": 0, "description": "Severity level"},
        "cap": {"type": "number", "minimum": 0, "maximum": 1},
        "factors": {"type": "object", "description": "Trigger-factor details"}
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": {"type": "string"},
          "status": {"type": "string"},
          "metrics": {"type": "object"},
          "flags": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "alerts": {
      "type": "object",
      "properties": {
        "critical": {"type": "array", "items": {"type": "string"}},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
