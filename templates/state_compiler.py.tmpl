#!/usr/bin/env python3
"""
state_compiler.py — Declarative State Compiler

Compiles raw data into a DecisionState JSON.
The LLM receives only this structure for logical decisions.

Usage:
  python3 state_compiler.py --compact   # <200 token output
  python3 state_compiler.py --json      # full JSON
"""

import json
import argparse
from datetime import datetime, timezone
from typing import Dict, List, Any, Optional


class StateCompiler:
    """
    Abstract base class: subclasses implement _compute_regime / _compute_items / _compute_alerts.
    """

    def compile(self) -> Dict[str, Any]:
        """Compile the full DecisionState."""
        return {
            'timestamp': datetime.now(timezone.utc).isoformat(),
            'regime': self._compute_regime(),
            'items': self._compute_items(),
            'alerts': self._compute_alerts(),
        }

    def _compute_regime(self) -> Dict:
        """Compute current environment state. Implement in subclass."""
        raise NotImplementedError

    def _compute_items(self) -> List[Dict]:
        """Compute per-item state. Implement in subclass."""
        raise NotImplementedError

    def _compute_alerts(self) -> Dict:
        """Compute alert list. Implement in subclass."""
        raise NotImplementedError

    def compact(self) -> str:
        """Minimal output (<200 tokens), fed directly to the LLM."""
        state = self.compile()
        lines = [
            f"Regime:{state['regime'].get('name','?')} "
            f"(L{state['regime'].get('level',0)}) "
            f"cap={state['regime'].get('cap',0):.0%}"
        ]
        for item in state.get('items', []):
            flags = ','.join(item.get('flags', []))
            flag_str = f"[{flags}]" if flags else ""
            lines.append(f"  {item['id']}{flag_str} {item.get('status','?')}")
        critical = state.get('alerts', {}).get('critical', [])
        if critical:
            lines.append(f"CRIT:{','.join(critical)}")
        return '\n'.join(lines)


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description='State Compiler')
    parser.add_argument('--compact', action='store_true', help='minimal output')
    parser.add_argument('--json', action='store_true', help='JSON output')
    args = parser.parse_args()

    # replace with your subclass
    compiler = StateCompiler()

    if args.json:
        print(json.dumps(compiler.compile(), indent=2, ensure_ascii=False, default=str))
    else:
        print(compiler.compact())
